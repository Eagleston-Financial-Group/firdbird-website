# Server-only settings. Never use a VITE_ prefix for database credentials.
DATABASE_URL=postgresql://USER:PASSWORD@pooler.example.invalid/firdbird?sslmode=verify-full
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@db.example.invalid/firdbird?sslmode=verify-full
PORT=3001
HOST=127.0.0.1
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001,http://127.0.0.1:3001

# Public site URL used for canonical links and the sitemap.
SITE_URL=http://localhost:3001
# Optional public tag IDs (safe in the browser bundle). Leave empty to keep tracking off.
VITE_SITE_URL=
VITE_GA4_ID=
VITE_GOOGLE_ADS_ID=
VITE_GOOGLE_ADS_LEAD_LABEL=
VITE_GOOGLE_ADS_CALL_LABEL=
VITE_META_PIXEL_ID=
